# Timescale Cloud / any Postgres. sslmode=require is expected for Timescale.
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# Set on Vercel production + preview only. If unset (e.g. local dev), the app is open.
# Username is hardcoded to "mayank" in src/proxy.ts.
AUTH_PASSWORD=
